<?xml version="1.0" ?>
<argos-configuration>

  <framework>
    <system threads="0" />
    <experiment length="0" ticks_per_second="10" random_seed="124" />
  </framework>

  <physics_engines>
    <dynamics2d id="dyn2d" />
  </physics_engines>

  <media>
    <simple_radio id="wifi" index="grid" grid_size="8,6,5"/>
    <range_and_bearing id="rab" />
  </media>

  <controllers>
    <argos_ros_bot_controller id="bot_ctrl" library="install/argos3_ros_bridge/lib/libargos_ros_bot.so">
      <actuators>
        <differential_steering implementation="default" />
        <simple_radios implementation="default" medium="wifi" show_rays="true" />
        <range_and_bearing implementation="default" />
      </actuators>
      <sensors>
        <footbot_proximity implementation="default" show_rays="true" />
        <positioning implementation="default" />
        <footbot_base_ground implementation="rot_z_only" />
        <simple_radios implementation="default" medium="wifi" show_rays="true" />
        <range_and_bearing implementation="medium" medium="rab" show_rays="true" range="0.5" />
      </sensors>
      <params stopWithoutSubscriberCount="10" />
    </argos_ros_bot_controller>
  </controllers>

  <!-- Arena centered at (1.6, 0.9, 0.5) to fit the 3.2m x 1.8m interior -->
  <arena size="4.2, 2.8, 1.0" center="1.6, 0.9, 0.5">
    <floor id="floor" source="loop_functions" pixels_per_meter="0" />

    <!-- Interior dimensions: 3.2m width x 1.8m height -->
    <box id="wall_north" size="3.25, 0.05, 0.5" movable="false">
      <body position="1.6, 1.825, 0" orientation="0,0,0" />
    </box>
    
    <box id="wall_south" size="3.25, 0.05, 0.5" movable="false">
      <body position="1.6, -0.025, 0" orientation="0,0,0" />
    </box>
    
    <box id="wall_east" size="0.05, 1.85, 0.5" movable="false">
      <body position="3.225, 0.9, 0" orientation="0,0,0" />
    </box>
    
    <box id="wall_west" size="0.05, 1.85, 0.5" movable="false">
      <body position="-0.025, 0.9, 0" orientation="0,0,0" />
    </box>

    <!-- Initial robot positions centered inside the 3.2m x 1.8m arena -->
    <foot-bot id="bot7" radio_medium="wifi" radio_range="0.5" rab_range="0.5">
      <body position="1.6, 0.9, 0" orientation="0,0,0" />
      <controller config="bot_ctrl" />
    </foot-bot>
    
    <foot-bot id="bot8" radio_medium="wifi" radio_range="0.5" rab_range="0.5">
      <body position="2.3, 0.9, 0" orientation="0,0,0" />
      <controller config="bot_ctrl" />
    </foot-bot>

    <foot-bot id="bot9" radio_medium="wifi" radio_range="0.5" rab_range="0.5">
      <body position="0.9, 0.9, 0" orientation="0,0,0" />
      <controller config="bot_ctrl" />
    </foot-bot>

    <foot-bot id="bot10" radio_medium="wifi" radio_range="0.5" rab_range="0.5">
      <body position="1.6, 1.35, 0" orientation="0,0,0" />
      <controller config="bot_ctrl" />
    </foot-bot>
    
    <foot-bot id="bot11" radio_medium="wifi" radio_range="0.5" rab_range="0.5">
      <body position="2.3, 1.35, 0" orientation="0,0,0" />
      <controller config="bot_ctrl" />
    </foot-bot>

    <foot-bot id="bot12" radio_medium="wifi" radio_range="0.5" rab_range="0.5">
      <body position="0.9, 1.35, 0" orientation="0,0,0" />
      <controller config="bot_ctrl" />
    </foot-bot>

    <foot-bot id="bot13" radio_medium="wifi" radio_range="0.5" rab_range="0.5">
      <body position="1.6, 0.45, 0" orientation="0,0,0" />
      <controller config="bot_ctrl" />
    </foot-bot>
    
    <foot-bot id="bot14" radio_medium="wifi" radio_range="0.5" rab_range="0.5">
      <body position="2.3, 0.45, 0" orientation="0,0,0" />
      <controller config="bot_ctrl" />
    </foot-bot>

    <foot-bot id="bot15" radio_medium="wifi" radio_range="0.5" rab_range="0.5">
      <body position="0.9, 0.45, 0" orientation="0,0,0" />
      <controller config="bot_ctrl" />
    </foot-bot>
  </arena>

  <visualization>
    <qt-opengl>
      <camera>
        <placements>
          <!-- Overhead camera centered at (1.6, 0.9) -->
          <placement index="0" position="1.6, 0.9, 3.2" look_at="1.6, 0.9, 0" up="0,1,0" lens_focal_length="20" />
        </placements>
      </camera>
    </qt-opengl>
  </visualization>

</argos-configuration>